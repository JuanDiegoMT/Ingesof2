{
  "info": {
    "name": "AgroDecide · API local",
    "description": "Ejecutar en orden tras crear la cuenta administradora. Usar una base de datos desechable. Las mediciones y sensores son datos sintéticos de prueba. La colección borra estos recursos al final y conserva la cuenta agricultora de prueba en la base local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "correo_admin",
      "value": ""
    },
    {
      "key": "contrasena_admin",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Registro de agricultor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/registro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correo_agricultor}}\",\n  \"contrasena\": \"{{contrasena_agricultor}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('correo_agricultor', 'prueba-' + pm.variables.replaceIn('{{$guid}}') + '@example.invalid');",
              "pm.collectionVariables.set('contrasena_agricultor', pm.variables.replaceIn('{{$guid}}'));",
              "['token_agricultor', 'token_admin', 'sensor_id', 'medicion_id'].forEach(nombre => pm.collectionVariables.unset(nombre));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Rol agricultor', () => pm.expect(pm.response.json().rol).to.eql('agricultor'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Inicio de sesión agricultor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correo_agricultor}}\",\n  \"contrasena\": \"{{contrasena_agricultor}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code < 300) pm.collectionVariables.set('token_agricultor', pm.response.json().access_token);",
              "pm.test('JWT de 15 minutos', () => pm.expect(pm.response.json().expires_in).to.eql(900));"
            ]
          }
        }
      ]
    },
    {
      "name": "Inicio de sesión administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{{login_admin_json}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const credenciales = {correo: pm.variables.get('correo_admin'), contrasena: pm.variables.get('contrasena_admin')};",
              "pm.variables.set('login_admin_json', JSON.stringify(credenciales));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code < 300) pm.collectionVariables.set('token_admin', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Lectura sin token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/sensores"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', function () { pm.response.to.have.status(401); });",
              "pm.test('Error uniforme', function () { const error = pm.response.json().error; pm.expect(error.codigo).to.be.a('string'); pm.expect(error.mensaje).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
